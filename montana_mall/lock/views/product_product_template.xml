<odoo>
<record id="view_product_template_locked" model="ir.ui.view">
        <field name="name">product.template.form.locked</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
        <xpath expr="//sheet" position="before">
            <header>
                <field name="si_locked" invisible="1"/>
                <button string="Lock" name="si_set_locked" type="object"
                        class="btn-primary"
                        invisible="si_locked == True"
                        />
                <button string="Unlock" name="si_set_locked" type="object"
                        class="btn-secondary"
                        invisible="si_locked == False"
                        />
            </header>
        </xpath>
        </field>
    </record>
</odoo>