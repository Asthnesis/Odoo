<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                    <div class="page">
                    <div style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;">
                    <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                    <tbody>
                        <colgroup>
                                <col width="40%"/>
                                <col width="20%"/>
                                <col width="40%"/>
                        </colgroup>
                        <tr>
                        
                        <td style="text-align:left">
                            <strong><t t-esc="res_company.name"/><br/></strong> 
                            <t t-esc="res_company.street"/><br/>
                            <t t-esc="res_company.street2"/>, <t t-esc="res_company.city"/><br/>
                            <t t-esc="res_company.phone"/><br/>  
                            <t t-esc="res_company.email"/><br/>
                            <t t-esc="res_company.website"/><br/></td>
                    
                    <td/>
                    
                    <td><img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo"/></td></tr>
                    </tbody>
                </table>
                 <br/>
                 <center><h1 style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace; color:#1f5999;">
                               <span><t t-esc="data['account_report_id'][1]"/></span>
                        </h1></center>
                        

                <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                <tbody>
                     <colgroup>
                            <col width="40%"/>
                             <col width="20%"/>
                            <col width="40%"/>
                    </colgroup>
                <tr>                    
                    <td style="text-align:left">
                    <t t-if="data['date_from']">
                                <strong style="color:#1f5999;">Date from :</strong>
                                <span t-esc="data['date_from']"/>
                                <br/>
                         </t>

                         <t t-if="data['date_to']">
                                <strong style="color:#1f5999;">Date to :</strong>
                                <span t-esc="data['date_to']"/>
                            </t>
                         <p t-if="data['target_move'] == 'all'"><strong style="color:#1f5999;">Target Moves:</strong>All Entries</p>
                         <p t-if="data['target_move'] == 'posted'"><strong style="color:#1f5999;">Target Moves:</strong> All Posted Entries</p>
                          
                    </td>
                   
                   <td style=" position: absolute; right: 10px; text-align: left;">
                        
                    </td>
                </tr>
                </tbody>
                <br/><br/>
            </table> 
                    <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4" t-if="data['debit_credit'] == 1">
                         <thead style="background-color: #deeaf6;font-weight:bold; display: table-header-group;">
                             <tr>
                                    <th style="color:#1f5999;">Name</th>
                                    <th class="text-end" style="color:#1f5999;">Debit</th>
                                    <th class="text-end" style="color:#1f5999;">Credit</th>
                                    <th class="text-end" style="color:#1f5999;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_account_lines" t-as="a">
                                    <t t-if="a['level'] != 0">
                                        <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                        <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>

                                        <td>
                                            <span style="color: white;" t-esc="'..' * int(a.get('level', 0))"/>
                                            <span t-att-style="style" t-esc="a.get('name')[:20] + '...' if len(a.get('name')) > 20 else a.get('name')"/>
                                        </td>
                                        <td class="text-end" style="white-space: text-nowrap;">
                                           <span t-att-style="style" t-esc="'{:,.2f}'.format(a.get('debit', 0.0))" />
                                        </td>
                                        <td class="text-end" style="white-space: text-nowrap;">
                                           <span t-att-style="style" t-esc="'{:,.2f}'.format(a.get('credit', 0.0))" />
                                        </td>
                                        <td class="text-end" style="white-space: text-nowrap;">
                                            <span t-att-style="style" t-esc="'{:,.2f}'.format(a.get('balance', 0.0))" />
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4" t-if="not data['enable_filter'] and not data['debit_credit']">
                            <thead style="background-color: #deeaf6;font-weight:bold; display: table-header-group;">

                                <tr>
                                    <th style="color:#1f5999;">Name</th>
                                    <th class="text-end" style="color:#1f5999;">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_account_lines" t-as="a">
                                    <t t-if="a['level'] != 0">
                                        <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                        <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>

                                        <td>
                                            <span style="color: white;" t-esc="'..' * int(a.get('level', 0))"/>
                                           <span t-att-style="style" t-esc="a.get('name')[:20] + '...' if len(a.get('name')) > 20 else a.get('name')"/>
                                        </td>
                                        <td class="text-end"><span t-att-style="style" t-esc="'{:,.2f}'.format(a.get('balance', 0.0))" /></td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4" t-if="data['enable_filter'] == 1 and not data['debit_credit']">
                            <thead style="background-color: #deeaf6;font-weight:bold; display: table-row-group;">

                                <tr>
                                    <th style="color:#1f5999;">Name</th>
                                    <th class="text-end" style="color:#1f5999;">Balance</th>
                                    <th class="text-end" style="color:#1f5999;"><span t-esc="data['label_filter']"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_account_lines" t-as="a">
                                    <t t-if="a['level'] != 0">
                                        <t t-if="int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: normal;'"/></t>
                                        <t t-if="not int(a.get('level')) &gt; 3"><t t-set="style" t-value="'font-weight: bold;'"/></t>
                                        <td>
                                            <span style="color: white;" t-esc="'..'"/>
                                            <span t-att-style="style" t-esc="a.get('name')[:20] + '...' if len(a.get('name')) > 20 else a.get('name')"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-att-style="style" t-esc="'{:,.2f}'.format(a.get('balance', 0.0))" />
                                        </td>
                                        <td class="text-end">
                                            <span t-att-style="style" t-esc="a.get('balance_cmp')" />
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
