<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_trialbalance">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="12"/>
            <t t-set="data_report_header_spacing" t-value="9"/>
            <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                <div style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;">
                   
                     <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                    <tbody>
                        <colgroup>
                                <col width="40%"/>
                                <col width="20%"/>
                                <col width="40%"/>
                        </colgroup>
                        <tr>
                        
                        <td style="text-align:left">
                            <strong><t t-esc="res_company.name"/><br/></strong> 
                            <t t-esc="res_company.street"/><br/>
                            <t t-esc="res_company.street2"/>, <t t-esc="res_company.city"/><br/>
                            <t t-esc="res_company.phone"/><br/>  
                            <t t-esc="res_company.email"/><br/>
                            <t t-esc="res_company.website"/><br/></td>
                    
                    <td/>
                    
                    <td><img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo"/></td></tr>
                    </tbody>
                </table>
                 <br/>
                 <center><h1 style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace; color:#1f5999;">
                               <span t-esc="res_company.name"/>: Trial Balance
                        </h1></center>

                    <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                <tbody>
                     <colgroup>
                            <col width="40%"/>
                             <col width="20%"/>
                            <col width="40%"/>
                    </colgroup>
                <tr>                    
                    <td style="text-align:left">
                        <div class="col-4">
                            <strong style="color:#1f5999;">Display Account:</strong>
                            <p>
                                <span t-if="data['display_account'] == 'all'">All accounts</span>
                                <span t-if="data['display_account'] == 'movement'">With movements</span>
                                <span t-if="data['display_account'] == 'not_zero'">With balance not equal to zero</span>
                            </p>
                        </div>
                        <div class="col-4">
                            <p>
                                <t t-if="data['date_from']"><strong style="color:#1f5999;">Date from :</strong> <span t-esc="data['date_from']"/><br/></t>
                                <t t-if="data['date_to']"><strong style="color:#1f5999;">Date to :</strong> <span t-esc="data['date_to']"/></t>
                            </p>
                        </div>
                        <div class="col-4">
                            <strong style="color:#1f5999;">Target Moves:</strong>
                            <p>
                                <span t-if="data['target_move'] == 'all'">All Entries</span>
                                <span t-if="data['target_move'] == 'posted'">All Posted Entries</span>
                            </p>
                        </div>
                        <div class="col-6">
                            <strong style="color:#1f5999;">Journals:</strong>
                            <p t-esc="', '.join([ lt or '' for lt in print_journal ])"/>
                        </div>
                        <div class="col-6">
                            <t t-if="analytic_accounts">
                                <strong style="color:#1f5999;">Analytic Accounts:</strong>
                                <p t-esc="', '.join([ analytic_account or '' for analytic_account in analytic_accounts ])"/>
                            </t>
                        </div>
                    
                    </td>
                   
                   <td style=" position: absolute; right: 10px; text-align: left;">
                        
                    </td>
                </tr>
                </tbody>
                <br/><br/>
            </table>

                    <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                     <thead style="background-color: #deeaf6;font-weight:bold; display: table-header-group;">
                            <tr>
                                <th style="color:#1f5999;">Code</th>
                                <th style="color:#1f5999;">Account</th>
                                <th style="color:#1f5999;" class="text-end">Debit</th>
                                <th style="color:#1f5999;" class="text-end">Credit</th>
                                <th style="color:#1f5999;" class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="Accounts" t-as="account">
                                <td>
                                    <span t-att-style="style" t-esc="account['code']"/>
                                </td>
                                <td>
                                    <span style="color: white;" t-esc="'..'"/>
                                   <span t-att-style="style" t-esc="(account.get('name') or '')[:25] + ('...' if account.get('name') and len(account['name']) > 25 else '')"/>
                                </td>
                                <td class="text-end">
                                    <span t-att-style="style" t-esc="'{:,.2f}'.format(account.get('debit', 0.0))"/>
                                </td>
                                <td class="text-end">
                                   <span t-att-style="style" t-esc="'{:,.2f}'.format(account.get('credit', 0.0))"/>
                                </td>
                                <td class="text-end">
                                    <span t-att-style="style" t-esc="'{:,.2f}'.format(account.get('balance', 0.0))"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

</odoo>
