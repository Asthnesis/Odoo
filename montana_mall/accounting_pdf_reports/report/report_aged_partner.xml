<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_agedpartnerbalance">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="12"/>
            <t t-set="data_report_header_spacing" t-value="9"/>
            <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">
                <div style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;">
                   
                     <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                    <tbody>
                        <colgroup>
                                <col width="40%"/>
                                <col width="20%"/>
                                <col width="40%"/>
                        </colgroup>
                        <tr>
                        
                        <td style="text-align:left">
                            <strong><t t-esc="res_company.name"/><br/></strong> 
                            <t t-esc="res_company.street"/><br/>
                            <t t-esc="res_company.street2"/>, <t t-esc="res_company.city"/><br/>
                            <t t-esc="res_company.phone"/><br/>  
                            <t t-esc="res_company.email"/><br/>
                            <t t-esc="res_company.website"/><br/></td>
                    
                    <td/>
                    
                    <td><img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)" alt="Logo"/></td></tr>
                    </tbody>
                </table>
                 <br/>
                 <center><h1 style="font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace; color:#1f5999;">
                               <span>Aged Partner Balance</span>
                        </h1></center>
                <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                <tbody>
                     <colgroup>
                            <col width="40%"/>
                             <col width="20%"/>
                            <col width="40%"/>
                    </colgroup>
                <tr>                    
                    <td style="text-align:left">
                        <t>
                                <strong style="color:#1f5999;">Date from :</strong>
                                <span t-esc="data['date_from']"/>
                            </t>
                            <br/>
                            <t>
                                <strong style="color:#1f5999;">Period Length (days):</strong>
                                <span t-esc="data['period_length']"/>
                            </t>
                            <p>
                                <span t-if="data['result_selection'] == 'customer'"> <strong style="color:#1f5999;">Accounts: </strong>Receivables</span>
                                <span t-if="data['result_selection'] == 'supplier'"><strong style="color:#1f5999;">Accounts: </strong>Payables</span>
                                <span t-if="data['result_selection'] == 'customer_supplier'"><strong style="color:#1f5999;">Accounts: </strong>Receivable and Payable</span>
                            </p>
                        
                         <p t-if="data['target_move'] == 'all'"><strong style="color:#1f5999;">Target Moves:</strong>All Entries</p>
                         <p t-if="data['target_move'] == 'posted'"><strong style="color:#1f5999;">Target Moves:</strong> All Posted Entries</p>
                        
                    </td>
                   
                   <td style=" position: absolute; right: 10px; text-align: left;">
                        
                    </td>
                </tr>
                </tbody>
                <br/><br/>
            </table> 

                    <table style="width:100%; font-size:18px; font-family: 'Fira Code', 'Source Code Pro', Consolas, 'Courier New', monospace;" class="table table-sm o_main_table table-borderless mt-4">
                         <thead style="background-color: #deeaf6;font-weight:bold; display: table-header-group;">
                            <tr>
                                <th style="color:#1f5999;">Partners</th>
                                <th class="text-end" style="color:#1f5999;">
                                    <span>Not due</span>
                                </th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="data['4']['name']"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="data['3']['name']"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="data['2']['name']"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="data['1']['name']"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="data['0']['name']"/></th>
                                <th class="text-end" style="color:#1f5999;">Total</th>
                            </tr>
                            <tr t-if="get_partner_lines">
                                <th style="color:#1f5999;">Account Total</th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[6])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[4])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[3])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[2])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[1])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[0])"/></th>
                                <th class="text-end" style="color:#1f5999;"><span t-esc="'{:,.2f}'.format(get_direction[5])"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="get_partner_lines" t-as="partner">
                                <td>
                                    <span t-esc="partner['name'][:25] + '...' if len(partner['name']) > 25 else partner['name']"/>

                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['direction'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['4'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['3'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['2'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['1'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['0'])"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:,.2f}'.format(partner['total'])"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

</odoo>
