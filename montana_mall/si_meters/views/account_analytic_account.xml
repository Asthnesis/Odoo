<odoo>
    <record id="view_account_analytic_account_form_extension" model="ir.ui.view">
        <field name="name">account.analytic.account.form.extension</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="industry_real_estate.property_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Electricity Meter">
                    <group>
                        <field name="si_meter_number" readonly ="id != 'False'" />
                        <field name="si_meter_status" readonly="1"/>
                        <field name="date_allocated" />
                        <field name="token_units" />
                        <field name="comments"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
