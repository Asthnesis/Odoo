<odoo>
<record id="view_partner_form_custom" model="ir.ui.view">
    <field name="name">res.partner.form.custom</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='phone']" position="attributes">
            <attribute name="placeholder">Enter 10-digit number [Starts with 0]</attribute>
        </xpath>

        <xpath expr="//field[@name='mobile']" position="attributes">
            <attribute name="placeholder">Enter 10-digit number [Starts with 0]</attribute>
        </xpath>

        <xpath expr="//field[@name='vat']" position="attributes">
            <attribute name="placeholder">Accepted Format: A123456789B</attribute>
        </xpath>
         <xpath expr="//notebook" position="inside">
                <page string="Linked Units">
                    <group>
                        <field name="linked_units_info" readonly="1" widget="text" />
                    </group>
                </page>
                <page name="si_unit_customer_link" string="SI Units">
                <group>
                    <field name="si_unit_customer_link" context="{'default_si_customer': active_id}">
                    <tree>
                        <field name="name"/>
                        <field name="x_rental_contract_id"/>
                    </tree>
                    </field>
                </group>
                </page>
        </xpath>
    </field>
</record>
</odoo>
