<odoo>
    <data noupdate="1">
        <record id="ir_cron_compute_customers" model="ir.cron">
            <field name="name">Compute Customers for Rental Contracts</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="state">code</field>
            <field name="code">model.compute_customers_for_contracts()</field>
            <field name="user_id" ref="base.user_root"/> <!-- Runs as admin -->
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field> <!-- Runs daily -->
            <field name="numbercall">-1</field> <!-- Run indefinitely -->
            <field name="doall" eval="False"/> <!-- Skip missed executions -->
        </record>
    </data>
</odoo>
